# ============================================================
# 10. ACR reverse-engineering research
# ============================================================

# Keep:
# research/acr/reports/*.md
# research/acr/reports/evidence/
# research/acr/tools/*.py
# native-renderer/src/acr_*.cpp
# native-renderer/src/acr_*.hpp
# native-renderer/tools/*.cpp
#
# These files contain source code, recovered formulas,
# reverse-engineering evidence, and validation programs.


# Temporary ACR research directories
/research/acr/tmp/
/research/acr/temp/
/research/acr/cache/
/research/acr/outputs/
/research/acr/test-output/
/research/acr/test-outputs/

# Local Ghidra databases and caches
/research/acr/ghidra-project/
/research/acr/ghidra-cache/

# Ghidra project database files
*.gpr
*.rep/

# Temporary Camera Raw investigation files
/research/acr/reports/evidence/lcr*

# Keep structured validation evidence unless specifically
# excluded by a more targeted rule.


